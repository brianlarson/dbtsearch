{#
  Soft-launch provider banner. Shown to guests unless dismissed
  (localStorage + cookie dbtsearch_provider_banner_dismissed) or already on /register.
#}
{% set portalModule = craft.app.getModule('portal') %}
{% set onboarding = portalModule ? portalModule.get('providerOnboarding') : null %}
{% set softLaunch = onboarding ? onboarding.isSoftLaunch() : false %}
{% set providerBannerDismissed = craft.app.request.getRawCookies().getValue('dbtsearch_provider_banner_dismissed') == '1' %}
{% set onRegisterPage = craft.app.request.segments|first == 'register' %}
{% if softLaunch and onboarding and not currentUser and not providerBannerDismissed and not onRegisterPage %}
{% set progress = onboarding.getDirectoryClaimProgress() %}
{% set claimedCount = progress.claimed %}
{% set totalCount = progress.total %}
{% set claimedPercent = totalCount > 0 ? ((claimedCount / totalCount) * 100)|round(1) : 0 %}
<style>
  .provider-banner {
    position: relative;
    background-color: #1e7a54;
    color: #ecfdf5;
    border-bottom: 1px solid #258a5f;
  }
  .provider-banner[hidden] {
    display: none !important;
  }
  .provider-banner-inner {
    box-sizing: border-box;
    width: 100%;
    max-width: 72rem;
    margin-inline: auto;
    padding: 0.55rem 1rem 1rem;
  }
  @media (min-width: 640px) {
    .provider-banner-inner {
      padding-inline: 1.5rem;
    }
  }
  @media (min-width: 768px) {
    .provider-banner-inner {
      padding: 0.7rem 1.5rem 1rem;
    }
  }
  @media (min-width: 1024px) {
    .provider-banner-inner {
      padding-inline: 2rem;
    }
  }
  .provider-banner-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    row-gap: 0.5rem;
    align-items: center;
  }
  @media (min-width: 768px) {
    .provider-banner-row {
      grid-template-columns: minmax(0, 1fr) auto;
      column-gap: 1rem;
      row-gap: 0;
    }
  }
  .provider-banner-copy {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.4;
    color: #ecfdf5;
  }
  @media (min-width: 768px) {
    .provider-banner-copy {
      font-size: 1rem;
    }
  }
  .provider-banner-meter {
    margin-top: 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    width: 100%;
    min-width: 0;
  }
  .provider-banner-meter-label {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    color: #d1fae5;
    white-space: nowrap;
  }
  .provider-banner-meter-track {
    height: 0.5rem;
    width: 100%;
    overflow: hidden;
    border-radius: 0;
    background-color: rgb(4 53 40 / 0.45);
  }
  .provider-banner-meter-fill {
    height: 100%;
    border-radius: 9999px;
    background-color: #a7f3d0;
  }
  .provider-banner-dismiss {
    display: inline;
    margin: 0 0 0 0.2em;
    padding: 0;
    border: 0;
    background: transparent;
    color: rgb(236 253 245 / 0.72);
    font: inherit;
    font-size: 0.8125em;
    font-weight: 500;
    line-height: inherit;
    text-decoration: underline;
    text-underline-offset: 0.15em;
    cursor: pointer;
  }
  .provider-banner-dismiss:hover {
    color: #fff;
  }
  .provider-banner-dismiss:focus-visible {
    outline: none;
    box-shadow: 0 0 0 0.2rem rgba(187, 206, 253, 0.45);
    color: #fff;
    border-radius: 0.15rem;
  }
  .provider-banner-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    justify-self: stretch;
    width: 100%;
    padding: 0.5rem 1rem;
    border: 1px solid #047857;
    border-radius: 0.5rem;
    background-color: #059669;
    color: #fff;
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.25;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
  }
  @media (min-width: 768px) {
    .provider-banner-cta {
      width: auto;
      justify-self: end;
    }
  }
  .provider-banner-siren {
    display: inline-block;
    transform-origin: 50% 80%;
  }
  .provider-banner:not([hidden]) .provider-banner-siren {
    animation: provider-banner-siren-attn 1.6s ease-in-out 1 both;
  }
  @keyframes provider-banner-siren-attn {
    0%, 100% {
      transform: scale(1) rotate(0deg);
      filter: brightness(1);
    }
    16% {
      transform: scale(1.08) rotate(-7deg);
      filter: brightness(1.28);
    }
    32% {
      transform: scale(1) rotate(6deg);
      filter: brightness(0.92);
    }
    50% {
      transform: scale(1.07) rotate(-6deg);
      filter: brightness(1.25);
    }
    68% {
      transform: scale(1) rotate(4deg);
      filter: brightness(0.94);
    }
    84% {
      transform: scale(1.05) rotate(-3deg);
      filter: brightness(1.18);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .provider-banner:not([hidden]) .provider-banner-siren {
      animation: none;
    }
  }
  .provider-banner-cta:hover {
    background-color: #10b981;
    border-color: #059669;
    color: #fff;
    opacity: 1;
  }
  .provider-banner-cta:focus-visible {
    outline: none;
    box-shadow: 0 0 0 0.25rem rgba(187, 206, 253, 0.45);
    color: #fff;
  }
</style>
<div
  id="provider-banner"
  class="provider-banner"
  role="region"
  aria-label="Provider registration notice"
>
  <div class="provider-banner-inner">
    <div class="provider-banner-row">
      <p class="provider-banner-copy">
        <span class="provider-banner-siren" aria-hidden="true">🚨</span>
        <strong>ATTN PROVIDERS:</strong>
        We have {{ claimedCount }} of {{ totalCount }} certified providers registered. If you're an owner or official rep sign up today to update location availability.
        <button type="button" class="provider-banner-dismiss" data-provider-banner-dismiss>(Dismiss)</button>
      </p>
      <a href="{{ url('register') }}" rel="nofollow" class="provider-banner-cta">Register</a>
    </div>
    <div
      class="provider-banner-meter"
      role="progressbar"
      aria-valuemin="0"
      aria-valuemax="{{ totalCount }}"
      aria-valuenow="{{ claimedCount }}"
      aria-valuetext="{{ claimedCount }} of {{ totalCount }} certified providers registered"
      aria-label="Certified providers registered"
    >
      <span class="provider-banner-meter-label">{{ claimedCount }} of {{ totalCount }}</span>
      <div class="provider-banner-meter-track">
        <div class="provider-banner-meter-fill" style="width: {{ claimedPercent }}%;"></div>
      </div>
    </div>
  </div>
</div>
<script>
  (function () {
    var COOKIE = 'dbtsearch_provider_banner_dismissed';
    var STORAGE = 'dbtsearch_provider_banner_dismissed';
    var MAX_AGE = 60 * 60 * 24 * 365;
    var bar = document.getElementById('provider-banner');
    if (!bar) return;
    try {
      if (localStorage.getItem(STORAGE) === '1') {
        document.cookie = COOKIE + '=1; path=/; max-age=' + MAX_AGE + '; SameSite=Lax';
        bar.hidden = true;
        return;
      }
    } catch (e) {}
    bar.querySelectorAll('[data-provider-banner-dismiss]').forEach(function (el) {
      el.addEventListener('click', function () {
        document.cookie = COOKIE + '=1; path=/; max-age=' + MAX_AGE + '; SameSite=Lax';
        try { localStorage.setItem(STORAGE, '1'); } catch (err) {}
        bar.hidden = true;
      });
    });
  })();
</script>
{% endif %}
