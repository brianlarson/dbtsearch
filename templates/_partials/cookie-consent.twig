{# Soft essential-cookies notice — not a CMP. Hidden until JS confirms no prior consent. #}
<div
  id="cookie-consent-bar"
  class="cookie-consent-bar"
  role="region"
  aria-label="Cookie notice"
  hidden
>
  <div class="cookie-consent-inner">
    <div class="cookie-consent-text">
      <p class="cookie-consent-copy">
        We use cookies for essential features (such as remembering your preferences on this device). Continuing to
        use the site assumes you are fine with that.
        <button
          type="button"
          class="cookie-consent-dismiss"
          data-cookie-consent-dismiss
          aria-label="Reject cookies tracking"
        >(Reject Cookies)</button>
      </p>
      {# <a href="{{ url('about') }}" class="cookie-consent-link">About DBT Search</a> #}
    </div>
    <div class="cookie-consent-actions">
      <button type="button" class="cookie-consent-accept" data-cookie-consent-dismiss>
        Accept
      </button>
    </div>
  </div>
</div>
