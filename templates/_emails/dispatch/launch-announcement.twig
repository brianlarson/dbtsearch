{#
  Dispatch campaign layout for the launch announcement.
  Point the campaign Template Path at: _emails/dispatch/launch-announcement

  Vars from Dispatch Sender: campaign, subscriber, unsubscribeUrl, content, settings
#}
{% set logoUrl = siteUrl('images/dbtsearch-logo.png') %}
{% set directoryUrl = siteUrl('directory') %}
{% set registerUrl = siteUrl('register') %}
{% set manageUrl = siteUrl('manage') %}
{% set firstName = subscriber.firstName ?? '' %}
{% set greetingName = firstName ? firstName : 'there' %}
{% set year = now|date('Y') %}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <title>{{ campaign.subject ?? 'DBT Search is live' }}</title>
</head>
<body style="margin:0;padding:0;background-color:#1d222a;color:#e2e8f0;-webkit-text-size-adjust:100%;-ms-text-size-adjust:100%;">
  <div style="display:none;max-height:0;overflow:hidden;mso-hide:all;">
    DBT Search is live. Find certified DBT providers in Minnesota with current availability.
  </div>
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#1d222a;margin:0;padding:0;">
    <tr>
      <td align="center" style="padding:32px 16px;">
        <table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" style="width:600px;max-width:600px;background-color:#242b36;border:1px solid #3d4f66;border-radius:12px;">
          <tr>
            <td align="center" style="padding:32px 32px 16px 32px;">
              <a href="{{ siteUrl('') }}" style="text-decoration:none;">
                <img src="https://www.dbtsearch.org/uploads/dbtsearch-logo.svg" alt="DBT Search" width="240" style="display:block;width:240px;max-width:100%;height:auto;border:0;">
              </a>
            </td>
          </tr>
          <tr>
            <td style="padding:8px 32px 8px 32px;font-family:Arial,Helvetica,sans-serif;font-size:16px;line-height:1.6;color:#e2e8f0;">
              <p style="margin:0 0 16px 0;">Hi {{ greetingName }},</p>
              {% if content %}
                {{ content|raw }}
              {% else %}
                <p style="margin:0 0 16px 0;">The Minnesota DBT directory is live. Search certified providers and see who currently has openings.</p>
                <p style="margin:0 0 16px 0;">If you represent a program in the directory, please register so you can keep availability up to date.</p>
              {% endif %}
            </td>
          </tr>
          <tr>
            <td align="center" style="padding:8px 32px 32px 32px;">
              <table role="presentation" cellpadding="0" cellspacing="0" border="0">
                <tr>
                  <td align="center" style="border-radius:8px;background-color:#6b8ef9;">
                    <a href="{{ directoryUrl }}" style="display:inline-block;padding:12px 22px;font-family:Arial,Helvetica,sans-serif;font-size:16px;font-weight:bold;color:#0f172a;text-decoration:none;">Find providers</a>
                  </td>
                  <td style="width:12px;font-size:0;line-height:0;">&nbsp;</td>
                  <td align="center" style="border-radius:8px;background-color:#0f172a;border:1px solid #bbcefd;">
                    <a href="{{ registerUrl }}" style="display:inline-block;padding:12px 22px;font-family:Arial,Helvetica,sans-serif;font-size:16px;font-weight:bold;color:#bbcefd;text-decoration:none;">Claim your listing</a>
                  </td>
                </tr>
              </table>
              <p style="margin:16px 0 0 0;font-family:Arial,Helvetica,sans-serif;font-size:13px;line-height:1.5;color:#94a8c4;">
                Already registered? <a href="{{ manageUrl }}" style="color:#bbcefd;text-decoration:underline;">Update availability</a>
              </p>
            </td>
          </tr>
          <tr>
            <td style="padding:24px 32px 32px 32px;border-top:1px solid #3d4f66;font-family:Arial,Helvetica,sans-serif;font-size:12px;line-height:1.6;color:#94a8c4;text-align:center;">
              <p style="margin:0 0 8px 0;">
                <strong style="color:#e2e8f0;">DBT Search</strong> is powered by
                <a href="https://www.tinytreecounseling.com/" style="color:#bbcefd;text-decoration:underline;">Tiny Tree Counseling &amp; Consulting</a>
              </p>
              <p style="margin:0 0 12px 0;">Copyright &copy; {{ year }} DBT Search.org. All rights reserved.</p>
              <p style="margin:0;">
                <a href="{{ unsubscribeUrl }}" style="color:#bbcefd;text-decoration:underline;">Unsubscribe</a>
              </p>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
